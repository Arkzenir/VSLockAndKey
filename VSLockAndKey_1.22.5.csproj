<Project Sdk="Microsoft.NET.Sdk">
  <!--
    VSLockAndKey - Vintage Story 1.22.5 build.
      dotnet build VSLockAndKey_1.22.5.csproj
      dotnet build VSLockAndKey_1.22.5.csproj -c Release   (also writes Releases/*.zip)
  -->

  <PropertyGroup>
    <VSVersion>1.22.5</VSVersion>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Written into the generated modinfo.json -->
  <ItemGroup>
  </ItemGroup>

  <!--
    Game path resolution, first non-empty wins:
      1. GameDirectory_1_22_5 from Properties/localSettings.props
      2. VINTAGE_STORY_1_22_5 environment variable
      3. VINTAGE_STORY environment variable
  -->
  <PropertyGroup>
    <GameDirectory Condition="'$(GameDirectory_1_22_5)' != ''">$(GameDirectory_1_22_5)</GameDirectory>
    <GameDirectory Condition="'$(GameDirectory)' == '' and '$(VINTAGE_STORY_1_22_5)' != ''">$(VINTAGE_STORY_1_22_5)</GameDirectory>
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(VINTAGE_STORY)</GameDirectory>
  </PropertyGroup>

  <Import Project="Common.Build.targets" />

</Project>
